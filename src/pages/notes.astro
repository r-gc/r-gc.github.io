---
import MainGridLayout from "@layouts/MainGridLayout.astro";
---

<MainGridLayout title="笔记" description="一些短的、杂的、但以后可能会救命的记录。">
    <section class="card-base px-9 py-8">
        <div class="mb-8">
            <div class="text-sm font-bold text-[var(--primary)] mb-2">Notes</div>
            <h1 class="text-3xl font-bold mb-3">笔记</h1>
            <p class="text-black/65 dark:text-white/65 leading-7">
                有些东西不一定值得写成长文章，但又不想下次再查一遍。这里就用来放命令、配置、排错记录、阅读摘记和一些半成型的想法。
            </p>
        </div>

        <div class="space-y-4">
            <div class="rounded-2xl border border-black/10 dark:border-white/10 p-5 bg-black/[0.02] dark:bg-white/[0.03]">
                <h2 class="text-xl font-bold mb-2">可能会常出现的主题</h2>
                <div class="flex flex-wrap gap-2 text-sm">
                    <span class="px-3 py-1 rounded-lg bg-[var(--btn-plain-bg-hover)]">Linux</span>
                    <span class="px-3 py-1 rounded-lg bg-[var(--btn-plain-bg-hover)]">前端</span>
                    <span class="px-3 py-1 rounded-lg bg-[var(--btn-plain-bg-hover)]">部署</span>
                    <span class="px-3 py-1 rounded-lg bg-[var(--btn-plain-bg-hover)]">数据库</span>
                    <span class="px-3 py-1 rounded-lg bg-[var(--btn-plain-bg-hover)]">AI 工具</span>
                </div>
            </div>

            <div class="rounded-2xl border border-black/10 dark:border-white/10 p-5 bg-black/[0.02] dark:bg-white/[0.03]">
                <h2 class="text-xl font-bold mb-2">先不急着分类太细</h2>
                <p class="text-sm text-black/60 dark:text-white/60 leading-6">
                    等笔记多起来之后，再按标签和系列慢慢整理。现在更重要的是先把有用的东西写下来。
                </p>
            </div>
        </div>
    </section>
</MainGridLayout>
