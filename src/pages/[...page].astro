---
import type { GetStaticPaths } from "astro";
import { Icon } from "astro-icon/components";
import Pagination from "../components/control/Pagination.astro";
import PostPage from "../components/PostPage.astro";
import { PAGE_SIZE } from "../constants/constants";
import { projects } from "../data/projects";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { getSortedPosts } from "../utils/content-utils";
import { getCategoryUrl, getPostUrlBySlug, getTagUrl } from "../utils/url-utils";

export const getStaticPaths = (async ({ paginate }) => {
	const allBlogPosts = await getSortedPosts();
	return paginate(allBlogPosts, { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;
// https://github.com/withastro/astro/issues/6507#issuecomment-1489916992

const { page } = Astro.props;

const len = page.data.length;
const isHomePage = page.currentPage === 1;
const allPosts = await getSortedPosts();
const notePosts = allPosts.filter((post) => post.data.category === "笔记");
const projectPosts = allPosts.filter((post) => post.data.category === "项目");
const blogPosts = allPosts.filter((post) => post.data.category === "博客");
const featuredProjects = projects.filter((project) => project.featured).slice(0, 3);
const featuredSlugs = [
	"notes/git-ssh/git-account-config",
	"notes/git-ssh/ssh-key-generation",
	"notes/git-ssh/ssh-proxy-and-config",
	"notes/docker/docker-status-check",
	"notes/docker/docker-container-keepalive-debug",
	"project-frappe-erpnext-myapp",
];
const featuredPosts = featuredSlugs
	.map((slug) => allPosts.find((post) => post.slug === slug))
	.filter((post): post is (typeof allPosts)[number] => Boolean(post));

const entryCards = [
	{
		title: "笔记",
		url: "/notes/",
		icon: "material-symbols:book-2-outline-rounded",
		count: notePosts.length,
		description: "Git、SSH、Docker、Linux、代理配置这些用到就能复制的速查内容。",
	},
	{
		title: "项目",
		url: "/projects/",
		icon: "material-symbols:tag-rounded",
		count: projects.length,
		description: "把 AI Recipe、Frappe / ERPNext、博客本身这些实践慢慢整理成记录。",
	},
	{
		title: "实验室",
		url: "/lab/",
		icon: "material-symbols:palette-outline",
		count: blogPosts.length,
		description: "后续放动画、背景、音乐、视频和页面交互这些好玩的 Web 实验。",
	},
];

const formatDate = (date: Date) =>
	date.toLocaleDateString("zh-CN", {
		year: "numeric",
		month: "2-digit",
		day: "2-digit",
	});
---

<MainGridLayout>
    {isHomePage ? (
        <div class="flex flex-col gap-4">
            <section class="card-base px-7 py-7 md:px-9 md:py-8 onload-animation">
                <div class="text-sm font-bold text-[var(--primary)] mb-2">RGC Blog</div>
                <h1 class="text-3xl md:text-4xl font-bold mb-4 leading-tight">
                    把常用知识整理成能复用的笔记。
                </h1>
                <p class="text-black/65 dark:text-white/65 leading-7 max-w-3xl">
                    这里主要记录代码、项目、配置、排错和一些 Web 实验。首页只保留入口和精选内容，真正的速查记录放在笔记里，完整时间线放在归档里。
                </p>
                <div class="flex flex-wrap gap-3 mt-6">
                    <a href="/notes/" class="btn-regular h-11 px-4 rounded-xl font-bold">
                        <Icon name="material-symbols:book-2-outline-rounded" class="text-xl mr-2"></Icon>
                        进入笔记
                    </a>
                    <a href="/archive/" class="btn-regular h-11 px-4 rounded-xl font-bold">
                        <Icon name="material-symbols:notes-rounded" class="text-xl mr-2"></Icon>
                        查看归档
                    </a>
                </div>
            </section>

            <section class="grid gap-4 md:grid-cols-3 onload-animation" style="animation-delay: calc(var(--content-delay) + 50ms);">
                {entryCards.map((entry) => (
                    <a href={entry.url} class="card-base group px-6 py-6 transition hover:-translate-y-0.5">
                        <div class="flex items-center justify-between gap-4 mb-5">
                            <div class="h-11 w-11 rounded-xl bg-[var(--btn-plain-bg-hover)] text-[var(--primary)] flex items-center justify-center">
                                <Icon name={entry.icon} class="text-2xl"></Icon>
                            </div>
                            <span class="text-sm text-[var(--primary)] bg-[var(--btn-plain-bg-hover)] rounded-lg px-2.5 py-1">
                                {entry.count}
                            </span>
                        </div>
                        <h2 class="text-xl font-bold mb-3 group-hover:text-[var(--primary)] transition">{entry.title}</h2>
                        <p class="text-sm text-black/60 dark:text-white/60 leading-6">{entry.description}</p>
                    </a>
                ))}
            </section>

            <section class="card-base px-7 py-7 md:px-9 md:py-8 onload-animation" style="animation-delay: calc(var(--content-delay) + 100ms);">
                <div class="flex items-end justify-between gap-4 mb-6">
                    <div>
                        <div class="text-sm font-bold text-[var(--primary)] mb-2">Featured</div>
                        <h2 class="text-2xl font-bold">精选速查</h2>
                    </div>
                    <a href="/notes/" class="text-sm font-bold text-[var(--primary)] hover:underline">全部笔记</a>
                </div>
                <p class="text-black/60 dark:text-white/60 leading-7 mb-5">
                    这里固定放最容易反复用到的内容：Git 账号、SSH key、SSH 代理、Docker 状态和项目实践。
                </p>

                <div class="divide-y divide-black/10 dark:divide-white/10">
                    {featuredPosts.map((post) => (
                        <article class="py-4 first:pt-0 last:pb-0">
                            <div class="flex flex-col gap-2 md:flex-row md:items-start md:justify-between">
                                <div class="min-w-0">
                                    <a href={getPostUrlBySlug(post.slug)} class="text-lg font-bold hover:text-[var(--primary)] transition">
                                        {post.data.title}
                                    </a>
                                    <p class="text-sm text-black/60 dark:text-white/60 leading-6 mt-2">{post.data.description}</p>
                                </div>
                                <time class="text-sm text-black/40 dark:text-white/40 shrink-0">{formatDate(post.data.published)}</time>
                            </div>
                            <div class="flex flex-wrap gap-2 mt-3">
                                {post.data.category && (
                                    <a href={getCategoryUrl(post.data.category)} class="px-2.5 py-1 rounded-lg text-xs bg-[var(--btn-plain-bg-hover)] text-[var(--primary)]">
                                        {post.data.category}
                                    </a>
                                )}
                                {post.data.tags.slice(0, 4).map((tag) => (
                                    <a href={getTagUrl(tag)} class="px-2.5 py-1 rounded-lg text-xs bg-black/[0.04] dark:bg-white/[0.06] text-black/55 dark:text-white/55">
                                        {tag}
                                    </a>
                                ))}
                            </div>
                        </article>
                    ))}
                </div>
            </section>

            <section class="card-base px-7 py-7 md:px-9 md:py-8 onload-animation" style="animation-delay: calc(var(--content-delay) + 150ms);">
                <div class="flex items-end justify-between gap-4 mb-6">
                    <div>
                        <div class="text-sm font-bold text-[var(--primary)] mb-2">Projects</div>
                        <h2 class="text-2xl font-bold">项目索引</h2>
                    </div>
                    <a href="/projects/" class="text-sm font-bold text-[var(--primary)] hover:underline">查看项目</a>
                </div>

                <div class="grid gap-4 md:grid-cols-3">
                    {featuredProjects.map((project) => (
                        <a href={project.articleUrl || "/projects/"} class="rounded-xl border border-black/10 dark:border-white/10 px-5 py-5 transition hover:border-[var(--primary)]/50 hover:bg-black/[0.02] dark:hover:bg-white/[0.03]">
                            <div class="text-xs font-bold text-[var(--primary)] mb-3">{project.status}</div>
                            <h3 class="text-lg font-bold mb-2">{project.title}</h3>
                            <p class="text-sm text-black/60 dark:text-white/60 leading-6">{project.summary}</p>
                        </a>
                    ))}
                </div>
            </section>
        </div>
    ) : (
        <>
            <PostPage page={page}></PostPage>
            <Pagination class="mx-auto onload-animation" page={page} style={`animation-delay: calc(var(--content-delay) + ${(len)*50}ms)`}></Pagination>
        </>
    )}
</MainGridLayout>
